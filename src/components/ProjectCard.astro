---
import type { Project } from '../lib/projects';
import Tag from './Tag.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card">
  <a class="card-media-link" href={`/work/${project.slug}`}>
    <div class="card-media">
      {
        project.cardImage ? (
          <img src={project.cardImage} alt={`Title screen from ${project.title}`} loading="lazy" />
        ) : (
          <div class="card-media-placeholder" aria-hidden="true">
            <span class="placeholder-eyebrow">{project.tool}</span>
            <span class="placeholder-title">{project.title}</span>
            {project.framework && (
              <span class="placeholder-framework">
                {project.framework.steps.map((s) => s.label).join(' → ')}
              </span>
            )}
          </div>
        )
      }
    </div>
  </a>

  <div class="card-body">
    <div class="card-tags">
      <Tag>{project.tool}</Tag>
      <Tag>{project.category}</Tag>
    </div>
    <h3 class="card-title">
      <a href={`/work/${project.slug}`}>{project.title}</a>
    </h3>
    <p class="card-description">{project.shortDescription}</p>
    {project.projectType && <p class="card-type">{project.projectType}</p>}
    <a class="card-link" href={`/work/${project.slug}`}>
      View Case Study
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-base) var(--ease-standard), transform var(--duration-base) var(--ease-standard);
  }

  .card:hover {
    border-color: var(--color-border-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-2px);
    }
  }

  .card-media-link {
    display: block;
  }

  .card-media {
    aspect-ratio: 16 / 10;
    background: var(--color-surface-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .card-media-placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
    padding: var(--space-lg);
    border-left: 3px solid var(--color-accent);
  }

  .placeholder-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .placeholder-title {
    font-family: var(--font-serif);
    font-size: var(--step-lg);
    line-height: 1.2;
    color: var(--color-text);
  }

  .placeholder-framework {
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .card-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .card-title {
    font-size: var(--step-md);
  }

  .card-title a {
    text-decoration: none;
    color: var(--color-text);
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-description {
    color: var(--color-text-muted);
    font-size: var(--step-sm);
    flex: 1;
  }

  .card-type {
    font-size: var(--step-xs);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .card-link {
    margin-top: 0.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-size: var(--step-sm);
    font-weight: 500;
    color: var(--color-accent);
  }

  .card-link:hover {
    color: var(--color-accent-hover);
  }
</style>
