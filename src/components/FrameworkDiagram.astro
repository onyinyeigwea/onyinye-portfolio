---
import type { Framework } from '../lib/projects';

interface Props {
  framework: Framework;
}

const { framework } = Astro.props;
---

<div class="framework">
  {framework.intro && <p class="framework-intro">{framework.intro}</p>}
  <div class="framework-steps">
    {
      framework.steps.map((step, i) => (
        <div class="framework-item">
          <div class="framework-step">
            <span class="step-label">{step.label}</span>
            {step.description && <span class="step-description">{step.description}</span>}
          </div>
          {i < framework.steps.length - 1 && (
            <span class="framework-arrow" aria-hidden="true">
              &rarr;
            </span>
          )}
        </div>
      ))
    }
  </div>
</div>

<style>
  .framework-intro {
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
    font-size: var(--step-sm);
  }

  .framework-steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-xs);
  }

  .framework-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .framework-step {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    min-width: 8rem;
  }

  .step-label {
    font-family: var(--font-mono);
    font-size: var(--step-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .step-description {
    font-size: var(--step-xs);
    color: var(--color-text-muted);
  }

  .framework-arrow {
    display: flex;
    align-items: center;
    color: var(--color-border-strong);
    font-size: var(--step-lg);
  }

  @media (max-width: 700px) {
    .framework-steps {
      flex-direction: column;
      align-items: stretch;
    }

    .framework-item {
      flex-direction: column;
    }

    .framework-arrow {
      transform: rotate(90deg);
      align-self: center;
    }
  }
</style>
