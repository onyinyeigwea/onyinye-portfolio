---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../lib/projects';
import { site, expertise } from '../lib/site';
---

<BaseLayout title={`${site.name} | ${site.title}`} description={site.description}>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="eyebrow">{site.name.toUpperCase()}</p>
      <h1>{site.title}</h1>
      <p class="hero-secondary">{site.secondaryTitle}</p>
      <p class="hero-statement">
        I design clear, engaging, and purposeful learning experiences that help people understand,
        practise, and apply what they learn.
      </p>
      <div class="hero-actions">
        <Button href="/work" variant="primary">View My Work</Button>
        <Button href="/contact" variant="secondary">Let's Connect</Button>
      </div>
    </div>
  </section>

  <!-- INTRODUCTION -->
  <section class="intro">
    <div class="wrap intro-inner">
      <h2 class="section-heading">Designing learning experiences with purpose.</h2>
      <div class="intro-copy">
        <p>
          I am an Educational Technology and Learning Professional with 13+ years of experience across
          education, instructional design, curriculum development, assessment, digital learning, and
          learner support.
        </p>
        <p>
          My work combines practical education experience with instructional design principles to create
          learning experiences that are structured, interactive, learner-centred, and aligned with
          real-world outcomes.
        </p>
        <p>
          I design for understanding, practice, application, and meaningful learner interaction — not
          simply content delivery.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT I DO -->
  <section class="what-i-do">
    <div class="wrap">
      <h2 class="section-heading">What I Do</h2>
      <ul class="expertise-grid">
        {expertise.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="selected-work">
    <div class="wrap">
      <div class="selected-work-header">
        <h2 class="section-heading">Selected Work</h2>
        <p class="section-intro">
          A selection of learning experiences demonstrating instructional design, eLearning development,
          curriculum transformation, interaction design, and assessment.
        </p>
      </div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="selected-work-cta">
        <Button href="/work" variant="secondary">View All Work</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    max-width: 46rem;
  }

  .hero h1 {
    font-size: var(--step-3xl);
    margin-block: var(--space-xs) var(--space-2xs);
  }

  .hero-secondary {
    font-family: var(--font-mono);
    font-size: var(--step-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .hero-statement {
    font-size: var(--step-md);
    color: var(--color-text-muted);
    max-width: 38rem;
    margin-bottom: var(--space-lg);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .intro {
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .intro-inner {
    display: grid;
    grid-template-columns: minmax(10rem, 20rem) 1fr;
    gap: var(--space-xl);
  }

  .intro-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 38rem;
  }

  .intro-copy p {
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .what-i-do {
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-muted);
  }

  .expertise-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    margin-top: var(--space-lg);
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .expertise-grid li {
    background: var(--color-surface);
    padding: var(--space-md);
    font-family: var(--font-serif);
    font-size: var(--step-md);
    color: var(--color-text);
  }

  .selected-work {
    padding-block: var(--space-2xl);
  }

  .selected-work-header {
    margin-bottom: var(--space-lg);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: var(--space-lg);
  }

  .selected-work-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
  }

  @media (max-width: 760px) {
    .intro-inner {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }
</style>
