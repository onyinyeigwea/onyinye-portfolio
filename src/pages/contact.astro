---
import BaseLayout from '../layouts/BaseLayout.astro';

const interests = [
  'Learning Experience and Instructional Design',
  'Educational Technology and Digital Learning',
  'Curriculum and Content Development',
  'Assessment and Learning Evaluation',
  'Education and Learning Projects',
];
---

<BaseLayout
  title="Contact"
  description="Onyinye Miriam Igwe is open to opportunities in Learning Experience Design, Instructional Design, Educational Technology, curriculum development, and assessment."
>
  <section class="contact-hero">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1 class="section-heading">Let's Work Together</h1>
      <p class="section-intro">
        I am open to opportunities where I can contribute to meaningful learning and
        education-focused work.
      </p>
    </div>
  </section>

  <section class="contact-interests">
    <div class="wrap">
      <p class="interests-label">I am particularly interested in</p>
      <ul class="interest-list">
        {interests.map((item) => <li>{item}</li>)}
      </ul>
      <p class="contact-outro">
        If you are reviewing my portfolio for a role, project, collaboration, or other
        opportunity, I would be glad to discuss how my experience could contribute.
      </p>
    </div>
  </section>

  <section class="contact-thanks">
    <div class="wrap">
      <p>Thank you for exploring my work.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .section-intro {
    margin-top: var(--space-sm);
    font-size: var(--step-md);
    max-width: 38rem;
  }

  .contact-interests {
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .interests-label {
    font-family: var(--font-mono);
    font-size: var(--step-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .interest-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 34rem;
    margin-bottom: var(--space-lg);
  }

  .interest-list li {
    position: relative;
    padding-left: 1.25rem;
    font-family: var(--font-serif);
    font-size: var(--step-md);
    color: var(--color-text);
    line-height: 1.5;
  }

  .interest-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .contact-outro {
    max-width: 38rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .contact-thanks {
    padding-block: var(--space-xl);
    text-align: center;
  }

  .contact-thanks p {
    font-family: var(--font-serif);
    font-size: var(--step-lg);
    color: var(--color-text);
  }
</style>
